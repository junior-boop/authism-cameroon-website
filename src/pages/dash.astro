---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title="Dashboard | Regard Autist" description="Tableau de bord pour la gestion des données de l'application." />
  </head>
  <body>
    <Header />
    <main class="dash-page">
      <Container>
        <section class="dash-hero">
          <p class="eyebrow">Espace administration</p>
          <h1>Dashboard de gestion des données</h1>
          <p>
            Suivez les métriques clés, le volume des contenus et les tâches à traiter pour maintenir
            les données de l'application à jour.
          </p>
        </section>

        <section class="stats-grid" aria-label="Résumé des indicateurs">
          <article class="stat-card">
            <h2>Dossiers créés</h2>
            <p class="value">128</p>
            <p class="trend up">+12% ce mois</p>
          </article>
          <article class="stat-card">
            <h2>En attente de validation</h2>
            <p class="value">19</p>
            <p class="trend">7 prioritaires</p>
          </article>
          <article class="stat-card">
            <h2>Mises à jour récentes</h2>
            <p class="value">43</p>
            <p class="trend up">+8 aujourd'hui</p>
          </article>
        </section>

        <section class="table-wrapper" aria-label="Dernières activités">
          <h2>Dernières activités de données</h2>
          <table>
            <thead>
              <tr>
                <th>Source</th>
                <th>Type</th>
                <th>Statut</th>
                <th>Dernière modification</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Formulaire contact</td>
                <td>Nouvelle entrée</td>
                <td><span class="badge pending">À traiter</span></td>
                <td>11/03/2026 - 10:42</td>
              </tr>
              <tr>
                <td>Blog</td>
                <td>Mise à jour</td>
                <td><span class="badge success">Validée</span></td>
                <td>11/03/2026 - 09:31</td>
              </tr>
              <tr>
                <td>Experts</td>
                <td>Suppression</td>
                <td><span class="badge review">Revue requise</span></td>
                <td>10/03/2026 - 16:18</td>
              </tr>
            </tbody>
          </table>
        </section>
      </Container>
    </main>
    <Footer />
  </body>
</html>

<style>
  .dash-page {
    background: #f8fafc;
    min-height: 70vh;
    padding: 1rem 0 4rem;
  }

  .dash-hero {
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
  }

  .eyebrow {
    color: #ef4444;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .dash-hero p {
    margin: 0.85rem 0 0;
    color: #475569;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .stat-card {
    background: white;
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
  }

  .stat-card h2 {
    font-size: 1rem;
    margin: 0;
    color: #334155;
  }

  .value {
    font-size: 2rem;
    font-weight: 700;
    margin: 0.5rem 0 0;
    color: #0f172a;
  }

  .trend {
    color: #64748b;
    margin: 0.25rem 0 0;
  }

  .trend.up {
    color: #16a34a;
  }

  .table-wrapper {
    background: white;
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    overflow-x: auto;
  }

  .table-wrapper h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #0f172a;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    text-align: left;
    padding: 0.75rem;
    border-bottom: 1px solid #e2e8f0;
    font-size: 0.95rem;
  }

  th {
    color: #334155;
    font-weight: 600;
  }

  .badge {
    display: inline-block;
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .badge.pending {
    background: #fef3c7;
    color: #92400e;
  }

  .badge.success {
    background: #dcfce7;
    color: #166534;
  }

  .badge.review {
    background: #e0e7ff;
    color: #3730a3;
  }
</style>
