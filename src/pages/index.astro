---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import Container from "../components/Container.astro"
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Title from '../components/Title.astro';
import ExpertView from '../components/ExpertView.astro';
import export_1 from '../assets/expert_1.jpg';
import export_2 from '../assets/expert_2.jpg';
import export_3 from '../assets/expert_3.jpg';
import Dote from '../components/Dote.astro';
import Quotespace from '../components/Quotespace.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<HeroSection />
		<section>
			<Container>
				<Title title="Comment les experts en parlent" subtitle="Découvrez les perspectives de professionnels spécialisés dans l'autisme." />
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<ExpertView src = {export_1} alt="Expert 1" />
					<ExpertView src = {export_2} alt="Expert 2" />
					<ExpertView src = {export_3} alt="Expert 3" />
				</div>
				<Dote />
				<Title title="Dans la vie de tous les jours" subtitle="Découvrez comment apporter des solutions adaptées aux besoins des personnes autistes." readmore={true} url="/expert-views" urlText="Voir tous les conseils" />
				<Quotespace src={export_1} alt="Expert 1" url="/expert-views" urlText="Lire tout l'article pour apprendre plus" />
			</Container>
		</section>
		<Footer />
	</body>
</html>
