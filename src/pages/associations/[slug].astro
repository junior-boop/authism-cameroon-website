---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Lightbox from "../../components/Lightbox.astro";
import ProseImages from "../../components/ProseImages.astro";
import JoinCta from "../../components/JoinCta.astro";
import { api, mediaUrl, type Association } from "../../lib/api";

const { slug } = Astro.params;

let association: Association | null = null;
try {
	const all = await api.associations();
	association = all.find((a) => a.slug === slug || a.id === slug) ?? null;
} catch {
	association = null;
}

if (!association) {
	Astro.response.status = 404;
}

let album: string[] = [];
if (association?.album) {
	try {
		const parsed = JSON.parse(association.album);
		if (Array.isArray(parsed)) album = parsed.filter((x): x is string => typeof x === "string");
	} catch {
		album = [];
	}
}
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={association ? association.name : "Association introuvable"}
			description={association?.description?.replace(/<[^>]+>/g, "").slice(0, 160) ??
				"Cette association n'a pas été trouvée."}
		/>
	</head>
	<body>
		<Header />

		{
			association ? (
				<>
					<section class="bg-gray-50">
						<Container>
							<div class="py-16 md:py-20 flex flex-col md:flex-row items-center gap-8">
								<div class="flex h-32 w-32 shrink-0 items-center justify-center border border-gray-200 bg-white p-4">
									{mediaUrl(association.logo) ? (
										<img
											src={mediaUrl(association.logo)!}
											alt={association.name}
											class="max-h-full max-w-full object-contain"
										/>
									) : (
										<span class="judson-bold text-gray-400 text-center">{association.name}</span>
									)}
								</div>
								<div class="text-center md:text-left">
									<h1 class="judson-bold text-4xl md:text-5xl text-[rgb(15,18,25)]">
										{association.name}
									</h1>
									{association.city && <p class="lato-regular text-xl text-gray-600 mt-3">{association.city}</p>}
								</div>
							</div>
						</Container>
					</section>

					<section>
						<Container>
							<div class="py-16 grid grid-cols-1 lg:grid-cols-3 gap-12">
								<div class="lg:col-span-2">
									<h2 class="judson-bold text-4xl text-[rgb(15,18,25)] mb-4">Présentation</h2>
									{association.description ? (
										<div class="text-xl prose-content lato-regular text-gray-700 mb-8" set:html={association.description} />
									) : (
										<p class="text-xl lato-regular text-gray-500">Aucune description disponible pour le moment.</p>
									)}

									{album.length > 0 && (
										<div class="mt-12">
											<h2 class="judson-bold text-2xl text-[rgb(15,18,25)] mb-4">Album photo</h2>
											<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
												{album.map((key) => (
													<button
														type="button"
														class="aspect-4/3 overflow-hidden bg-gray-100 cursor-zoom-in"
														data-lightbox-src={mediaUrl(key)!}
														data-lightbox-alt={association!.name}
														data-lightbox-group="album"
													>
														<img src={mediaUrl(key)!} alt={association!.name} class="h-full w-full object-cover" />
													</button>
												))}
											</div>
										</div>
									)}
								</div>

								<aside class="bg-gray-100 p-6 h-fit">
									<h2 class="judson-bold text-xl text-[rgb(15,18,25)] mb-4">Contact</h2>
									<ul class="lato-regular text-gray-700 space-y-3">
										{association.address && <li>{association.address}</li>}
										{association.email && (
											<li>
												<a href={`mailto:${association.email}`} class="hover:text-[#FF5656] transition-colors">
													{association.email}
												</a>
											</li>
										)}
										{association.phone && (
											<li>
												<a href={`tel:${association.phone}`} class="hover:text-[#FF5656] transition-colors">
													{association.phone}
												</a>
											</li>
										)}
									</ul>
									<div class="mt-6 flex flex-wrap gap-3">
										{association.phone && (
											<a
												href={`https://wa.me/${association.phone.replace(/[^0-9]/g, "")}`}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex px-4 py-2 items-center gap-2 border border-[#25D366] rounded-4xl bg-[#25D366] text-white lato-bold"
											>
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5 fill-current">
													<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.63 1.44 5.15L2 22l5.1-1.53a9.87 9.87 0 0 0 4.94 1.33h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2m0 1.67c2.21 0 4.28.86 5.84 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.02.91.91-2.95-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.55 3.7-8.42 8.06-8.42M8.53 7.33c-.16 0-.42.06-.6.26-.2.21-.78.76-.78 1.85s.8 2.15.9 2.3c.12.15 1.56 2.5 3.84 3.4 1.9.75 2.29.6 2.7.56.4-.04 1.3-.53 1.48-1.04.18-.5.18-.94.13-1.03-.06-.1-.2-.15-.4-.25-.22-.1-1.3-.64-1.5-.72-.2-.07-.35-.1-.5.1-.14.22-.56.72-.69.86-.13.15-.25.17-.47.06-.22-.1-.93-.34-1.76-1.09-.65-.58-1.09-1.3-1.22-1.51-.12-.22-.01-.34.1-.44.1-.1.22-.26.33-.39.1-.13.14-.22.21-.37.07-.15.04-.28-.02-.39-.06-.1-.5-1.26-.7-1.72-.18-.44-.37-.38-.5-.39z"/>
												</svg>
												WhatsApp
											</a>
										)}
										{association.website && (
											<a
												href={association.website}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex px-4 py-2 items-center border border-[#FF5656] rounded-4xl bg-[#FF5656] text-white lato-bold"
											>
												Visiter le site
											</a>
										)}
									</div>
								</aside>
							</div>
						</Container>
					</section>
				</>
			) : (
				<section>
					<Container>
						<div class="py-24 text-center">
							<h1 class="judson-bold text-4xl text-[rgb(15,18,25)]">Association introuvable</h1>
							<p class="lato-regular text-gray-600 mt-4">
								Cette association n'existe pas ou a été retirée.
							</p>
							<a href="/associations" class="lato-bold text-[#FF5656] hover:underline mt-6 inline-block">
								Retour aux associations
							</a>
						</div>
					</Container>
				</section>
			)
		}

		<JoinCta />

		<Footer />
		<Lightbox />
		<ProseImages />
	</body>
</html>
