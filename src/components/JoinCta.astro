---
import Container from "./Container.astro";
---

<section class="bg-[rgb(15,18,25)]">
	<Container>
		<div class="py-16 md:py-20 max-w-2xl mx-auto text-center">
			<h2 class="judson-bold text-3xl md:text-4xl text-white">Vous voulez agir à nos côtés ?</h2>
			<p class="lato-regular text-lg text-gray-300 mt-4">
				Rejoignez une association ou apportez votre soutien pour accompagner les personnes
				autistes et leurs familles au Cameroun.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-4 mt-8">
				<a
					href="/associations"
					class="px-6 py-3 inline-flex items-center border border-[#FF5656] rounded-4xl bg-[#FF5656] text-white lato-bold hover:bg-[#e64545] transition-colors"
				>
					Rejoindre une association
				</a>
				<a
					href="/associations"
					class="px-6 py-3 inline-flex items-center border border-white/30 rounded-4xl text-white lato-bold hover:border-[#FF5656] hover:text-[#FF5656] transition-colors"
				>
					Accompagner une association
				</a>
			</div>
		</div>
	</Container>
</section>
