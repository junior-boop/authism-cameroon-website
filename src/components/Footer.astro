---
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";
import Container from "./Container.astro";
import images from "../assets/regard_autist.png";

const year = new Date().getFullYear();

const quickLinks = [
	{ href: "/about", label: "Notre Mission" },
	{ href: "/associations", label: "Associations" },
	{ href: "/blog", label: "Actualités" },
	{ href: "/events", label: "Évenements" },
];
---

<footer class="bg-white border-t border-gray-100">
	<Container>
		<div class="py-16 grid grid-cols-1 gap-12 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<a href="/" class="flex items-center gap-2">
					<Image src={images} alt={SITE_TITLE} height={48} />
				</a>
				<p class="lato-regular text-gray-600 mt-4 max-w-sm">
					Nous accompagnons les personnes autistes et leurs familles au Cameroun à travers
					l'information, le soutien et la mise en réseau d'associations engagées.
				</p>
				<div class="flex gap-3 mt-6">
					<a
						href="#"
						aria-label="Facebook"
						class="flex items-center justify-center w-10 h-10 rounded-4xl text-gray-500 hover:bg-[#FF5656] hover:border-[#FF5656] hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/cyberalien/RemixIcon/blob/master/License --><path fill="currentColor" d="M12.001 2c-5.523 0-10 4.477-10 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89c1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.344 21.129 22 16.992 22 12c0-5.523-4.477-10-10-10"/></svg>
					</a>
					<a
						href="#"
						aria-label="X"
						class="flex items-center justify-center w-10 h-10 rounded-4xl text-gray-500 hover:bg-[#FF5656] hover:border-[#FF5656] hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/cyberalien/RemixIcon/blob/master/License --><path fill="currentColor" d="M10.488 14.651L15.25 21h7l-7.858-10.478L20.93 3h-2.65l-5.117 5.886L8.75 3h-7l7.51 10.015L2.32 21h2.65zM16.25 19L5.75 5h2l10.5 14z"/></svg>
					</a>
					<a
						href="#"
						aria-label="LinkedIn"
						class="flex items-center justify-center w-10 h-10 rounded-4xl text-gray-500 hover:bg-[#FF5656] hover:border-[#FF5656] hover:text-white transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/cyberalien/RemixIcon/blob/master/License --><path fill="currentColor" d="M6.94 5a2 2 0 1 1-4-.002a2 2 0 0 1 4 .002M7 8.48H3V21h4zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91z"/></svg>
					</a>
				</div>
			</div>

			<div>
				<h3 class="judson-bold text-lg text-[rgb(15,18,25)]">Navigation</h3>
				<ul class="mt-4 space-y-3">
					{quickLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="lato-regular text-gray-600 hover:text-[#FF5656] transition-colors"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h3 class="judson-bold text-lg text-[rgb(15,18,25)]">Contact</h3>
				<ul class="mt-4 space-y-3 lato-regular text-gray-600">
					<li>
						<a href="mailto:contact@regard-autist.fr" class="hover:text-[#FF5656] transition-colors">
							contact@regard-autist.fr
						</a>
					</li>
					<li>Yaoundé, Cameroun</li>
				</ul>
				<a
					class="mt-6 inline-flex px-4 py-2 gap-2 items-center border border-[#FF5656] rounded-4xl bg-[#FF5656] text-white lato-bold"
					href="mailto:contact@regard-autist.fr">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
						<path
							fill="currentColor"
							d="M6.455 19L2 22.5V4a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1z"
						></path>
					</svg>
					Contactez-nous
				</a>
			</div>
		</div>

		<div class="border-t border-gray-100 py-6 flex flex-col sm:flex-row items-center justify-between gap-2">
			<p class="lato-regular text-sm text-gray-500">&copy; {year} Regard Autiste. Tous droits réservés.</p>
			<p class="lato-regular text-sm text-gray-500">Association pour l'inclusion des personnes autistes au Cameroun</p>
		</div>
	</Container>
</footer>
