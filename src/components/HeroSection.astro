---
interface Props {
    title?: string;
    subtitle1?: string;
    subtitle2?: string;
    height?: string;
}

const title = Astro.props.title ?? "Je suis Autiste";
const subtitle1 =
    Astro.props.subtitle1 ??
    "Ma différence n’est pas une limite, c’est une autre façon de percevoir le monde.";
const subtitle2 =
    Astro.props.subtitle2 ??
    "Chaque personne autiste mérite une écoute attentive, un diagnostic précoce et un accompagnement adapté pour développer pleinement son potentiel. Ensemble, agissons pour une prise en charge bienveillante et efficace.";
const height = Astro.props.height ?? "800px";
---

<section id="hero_section" style={`--hero-height: ${height}`}>
    <div class="bg_image"></div>
    <div class="z-10 relative max-w-[750px] mx-auto px-4 text-center">
        <h1 class="text-8xl font-bold judson-bold">{title}</h1>
        <p class="text-xl text-gray-700 font-semibold">{subtitle1}</p>
        {subtitle2 && <p class="text-xl text-gray-700 font-semibold">{subtitle2}</p>}
    </div>
</section>

<style>
    #hero_section {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        height: var(--hero-height);
        background-color: #f5f5f5;
        text-align: center;
        position: relative;
        z-index: 1;
        padding: 5em 0;

        .bg_image {
            background-image: url('../assets/hero_2.jpg');
            background-size: cover;
            background-position: center;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.5;
            z-index: -1;
        }
    }

    #hero_section:after {
        background: linear-gradient(180deg, hsla(0, 0%, 88%, 0) 10.9%, white 100%);
        content: "";
        height: 100%;
        left: 0;
        position: absolute;
        top: 0;
        width: 100%;
    }
</style>