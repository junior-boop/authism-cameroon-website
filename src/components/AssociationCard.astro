---
interface Props {
	name: string;
	imageSrc?: string | null;
	imageAlt?: string;
	href?: string;
}

const { name, imageSrc, imageAlt = name, href = "#" } = Astro.props;
---

<a
	href={href}
	class="group flex aspect-square items-center justify-center border border-gray-200 bg-white p-6 transition-colors hover:border-[#FF5656] hover:shadow-sm"
>
	{
		imageSrc ? (
			<img src={imageSrc} alt={imageAlt} class="max-h-full max-w-full object-contain" />
		) : (
			<span class="judson-bold text-center text-gray-700 group-hover:text-[#FF5656]">{name}</span>
		)
	}
</a>
