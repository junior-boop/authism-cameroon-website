---
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import images from "../assets/regard_autist.png";

const navLinks = [
	{
		href: "/associations",
		label: "Associations",
		icon: `<circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17.5" cy="9.5" r="2.3"/><path d="M14 20a4.2 4.2 0 0 1 8.4 0"/>`,
	},
	{
		href: "/about",
		label: "Notre Mission",
		icon: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>`,
	},
	{
		href: "/blog",
		label: "Actualités",
		icon: `<rect x="4" y="3" width="13" height="18" rx="1.5"/><line x1="7" y1="7" x2="14" y2="7"/><line x1="7" y1="11" x2="14" y2="11"/><line x1="7" y1="15" x2="11" y2="15"/>`,
	},
	{
		href: "/events",
		label: "Évenements",
		icon: `<rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/>`,
	},
];
---

<header class = "padding-0 lg:px-4">
	<nav>
		<div>
			<a href='/' class='flex items-center gap-2'>
				<Image src={images} alt={SITE_TITLE} class='h-4 h-[48px] w-auto' />
			</a>
		</div>
		<div class='internal-links hidden lg:flex'>
			<HeaderLink href='/associations'>Associations</HeaderLink>
			<HeaderLink href='/about'>Notre Mission</HeaderLink>
			<HeaderLink href='/blog'>Actualités</HeaderLink>
			<HeaderLink href='/events'>Évenements</HeaderLink>
			<a
				class='px-4 py-2 flex gap-2 items-center border border-[#FF5656] rounded-4xl bg-[#FF5656] text-white'
				href='mailto:contact@regard-autist.fr'>
				<span>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='20'
						height='20'
						viewBox='0 0 24 24'
						><!-- Icon from Remix Icon by Remix Design - https://github.com/Remix-Design/RemixIcon/blob/master/License -->
						<path
							fill='currentColor'
							d='M6.455 19L2 22.5V4a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1z'
						></path></svg
					>
				</span>
				<span class='font-bold'>Contactez-nous</span>
			</a>
		</div>

		<button
			type='button'
			data-menu-open
			aria-label='Ouvrir le menu'
			class='flex lg:hidden items-center justify-center h-11 w-11 text-black'>
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/cyberalien/RemixIcon/blob/master/License --><path fill="currentColor" d="M3 4h18v2H3zm6 7h12v2H9zm-6 7h18v2H3z"/></svg>
		</button>
	</nav>
</header>

<div
	data-menu-panel
	class='fixed inset-0 z-50 flex translate-x-full flex-col justify-between bg-white transition-transform duration-300 ease-in-out sm:hidden'>
	<div>
		<div class='flex items-center justify-between px-6 pt-6 pb-3'>
			<a href='/' class='flex items-center gap-2'>
				<Image src={images} alt={SITE_TITLE} height={34} />
			</a>
			<button type='button' data-menu-close aria-label='Fermer le menu' class='text-4xl leading-none text-black'>
				&times;
			</button>
		</div>
		<nav>
			<ul class='w-full flex flex-col list-none gap-4 px-5 mt-4'>
				<span class='w-full border-t border-white/10'></span>
				{
					navLinks.map((link) => (
						<>
							<li>
								<a
									href={link.href}
									class='lato-regular text-lg text-white hover:text-[#FF5656] transition-colors flex items-center gap-3 pl-4'
								>
									<svg
										xmlns='http://www.w3.org/2000/svg'
										width='18'
										height='18'
										viewBox='0 0 24 24'
										fill='none'
										stroke='currentColor'
										stroke-width='1.6'
										stroke-linecap='round'
										stroke-linejoin='round'
										set:html={link.icon}
										
									/>
									{link.label}
								</a>
							</li>
							<span class='w-full border-t border-black/10' />
						</>
					))
				}
				<li class='mt-2'>
					<a
						href='mailto:contact@regard-autist.fr'
						class='lato-bold inline-flex items-center gap-2 px-4 py-2 border border-[#FF5656] rounded-4xl bg-[#FF5656] text-white w-full'>
						<svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24'>
							<path
								fill='currentColor'
								d='M6.455 19L2 22.5V4a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1z'
							></path>
						</svg>
						Contactez-nous
					</a>
				</li>
			</ul>
		</nav>
	</div>

	<div class='flex items-center justify-between px-5 pb-6'>
		<p class='lato-regular text-sm text-black/60'>&copy; {new Date().getFullYear()} Regard Autiste</p>
		<div class='flex gap-3'>
			<a
				href='#'
				aria-label='Facebook'
				class='flex items-center justify-center w-9 h-9 rounded-4xl  text-black hover:bg-[#FF5656] hover:border-[#FF5656] transition-colors'>
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/cyberalien/RemixIcon/blob/master/License --><path fill="currentColor" d="M12.001 2c-5.523 0-10 4.477-10 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89c1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.344 21.129 22 16.992 22 12c0-5.523-4.477-10-10-10"/></svg>
			</a>
			<a
				href='#'
				aria-label='X'
				class='flex items-center justify-center w-9 h-9 rounded-4xl  text-black hover:bg-[#FF5656] hover:border-[#FF5656] transition-colors'>
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/cyberalien/RemixIcon/blob/master/License --><path fill="currentColor" d="M10.488 14.651L15.25 21h7l-7.858-10.478L20.93 3h-2.65l-5.117 5.886L8.75 3h-7l7.51 10.015L2.32 21h2.65zM16.25 19L5.75 5h2l10.5 14z"/></svg>
			</a>
			<a
				href='#'
				aria-label='LinkedIn'
				class='flex items-center justify-center w-9 h-9 rounded-4xl  text-black hover:bg-[#FF5656] hover:border-[#FF5656] transition-colors'>
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/cyberalien/RemixIcon/blob/master/License --><path fill="currentColor" d="M6.94 5a2 2 0 1 1-4-.002a2 2 0 0 1 4 .002M7 8.48H3V21h4zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91z"/></svg>
			</a>
		</div>
	</div>
</div>

<script>
	const openBtn = document.querySelector("[data-menu-open]");
	const closeBtn = document.querySelector("[data-menu-close]");
	const panel = document.querySelector("[data-menu-panel]");

	function openMenu() {
		panel?.classList.remove("translate-x-full");
		document.body.style.overflow = "hidden";
	}

	function closeMenu() {
		panel?.classList.add("translate-x-full");
		document.body.style.overflow = "";
	}

	openBtn?.addEventListener("click", openMenu);
	closeBtn?.addEventListener("click", closeMenu);
	panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
</script>

<style>
	header {
		margin: 0;
		background: white;
		/* box-shadow: 0 2px 8px rgba(var(--black), 5%); */
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1em 1em;

		& > div {
			flex: 1;
			/* display: flex; */
			align-items: center;
			gap: 2em;
		}

		.internal-links {
			flex: 1;
			justify-content: flex-end;
		}
	}

	nav a {
		color: var(--black);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
