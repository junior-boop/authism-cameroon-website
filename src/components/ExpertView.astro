---
import { Image } from "astro:assets";
const imageSrc = Astro.props.src;
const imageAlt = Astro.props.alt;

const texte =
    "L'autisme est une condition neurodéveloppementale qui affecte la communication et les interactions sociales. Il est important de comprendre que chaque personne autiste est unique et mérite un soutien adapté à ses besoins.";
const shortText = texte.length > 85 ? texte.substring(0, 85) + "..." : texte;
---

<div class='export_view'>
    <div class='images'>
        <Image src={imageSrc} alt={imageAlt} />
    </div>
    <div class='content'>
        <h2 class='text-4xl font-bold judson-bold mb-2 z-10'>Dr. Jane Doe</h2>
        <p class='text-sm z-10'>Psychologue spécialisée dans l'autisme</p>
        <p class='text-lg mt-5 font-bold z-10'>{shortText}</p>
    </div>
</div>

<style>
    .export_view {
        position: relative;
        width: 100%;
        aspect-ratio: 2/3;
        overflow: hidden;

        .images {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            img:hover {
                transform: scale(1.05);
                transition: all 0.3s ease-in-out;
            }
        }

        .content {
            position: absolute;
            background: rgba(0, 0, 0, 0.3);
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            color: white;
            padding: 2em;
            transition: all 0.3s ease-in-out;

            &::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(
                    180deg,
                    hsla(0, 0%, 88%, 0) 50%,
                    #000000 100%
                );
                z-index: 1;
            }

            h2 {
                color: white;
            }
        }

        .content:hover {
            background: linear-gradient(
                180deg,
                hsla(0, 0%, 88%, 0) 50%,
                #ffffff 100%
            );
        }
    }
</style>
