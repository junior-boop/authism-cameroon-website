---
type props = {
    title?: string;
    subtitle?: string;
    readmore?: boolean;
    url?: string;
    urlText?: string;
}

const titre = Astro.props.title || "Ce qu'en pensent les experts";
const subtitle = Astro.props.subtitle || "Découvrez les perspectives de professionnels spécialisés dans l'autisme.";
const readmoreactive = Astro.props.readmore || false;
const url = readmoreactive ? Astro.props.url : "#";
const urlText = readmoreactive ? Astro.props.urlText : "Lire plus";
---

<div class={`mt-16 sm:mt-20 lg:mt-28 flex flex-col sm:flex-row sm:items-start justify-between gap-4 sm:gap-6 mb-5 ${readmoreactive ? "border-b-5 border-gray-900 pb-7" : ''}`}>
    <div class="w-full sm:w-[35%]">
        <h1 class="text-4xl sm:text-4xl md:text-5xl font-bold mb-0 judson-bold">{titre}</h1>
    </div>
    <div class="w-full sm:w-[50%]">
        <p class="text-base sm:text-lg md:text-xl text-gray-600 mt-2">{subtitle}</p>
        {
            readmoreactive && (<a href={url} class="flex gap-4 items-center hover:underline mt-4 text-lg font-bold text-gray-700">
            <div class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-600 hover:bg-gray-900 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><!-- Icon from Remix Icon by Remix Design - https://github.com/Remix-Design/RemixIcon/blob/master/License --><path fill="currentColor" d="m16.172 11l-5.364-5.364l1.414-1.414L20 12l-7.778 7.778l-1.414-1.414L16.172 13H4v-2z"/></svg>
            </div>
            {urlText}
        </a>)
        }
    </div>
</div>